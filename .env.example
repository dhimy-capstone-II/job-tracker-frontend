# Copy this file to .env, then run: npm run dev
# .env is gitignored. This file is committed, so it must never contain real secrets.

# Where the Express backend is running.
VITE_API_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Auth0 (OPTIONAL)
# ---------------------------------------------------------------------------
# Leave these blank to run the app with email + password login only.
# The app works fully without them; the "Continue with Auth0" button is simply
# not shown. Fill all three in if you want social login.
VITE_AUTH0_DOMAIN=
VITE_AUTH0_CLIENT_ID=
VITE_AUTH0_AUDIENCE=
